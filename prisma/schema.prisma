generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("client") // "admin" | "client"
  createdAt DateTime @default(now())
}

model Venue {
  id            String              @id
  name          String
  address       String
  zone          String
  capacity      Int
  sqft          Int
  type          String
  features      String              // JSON array
  daysOpen      Int
  weeklyTraffic Int
  notes         String?
  imageUrl      String?
  posData       POSRecord[]
  reservations  ReservationRecord[]
}

model POSRecord {
  id             String   @id @default(cuid())
  venueId        String
  venue          Venue    @relation(fields: [venueId], references: [id])
  businessDate   DateTime
  menuGroup      String
  menuItem       String
  spiritCategory String?
  qtySold        Int
  grossSales     Float
  itemCost       Float
  netSales       Float
  voidQty        Int      @default(0)
  compQty        Int      @default(0)
  source         String   // "csv_upload" | "toast_api" | "sample"
  importedAt     DateTime @default(now())

  @@index([venueId, businessDate])
  @@index([spiritCategory])
  @@index([menuItem])
}

model ReservationRecord {
  id            String   @id @default(cuid())
  venueId       String
  venue         Venue    @relation(fields: [venueId], references: [id])
  date          DateTime
  time          String
  partySize     Int
  status        String
  source        String
  guestName     String?
  visitCount    Int      @default(1)
  lifetimeSpend Float    @default(0)
  tags          String?
  noShow        Boolean  @default(false)
  dataSource    String   // "csv_upload" | "sevenrooms_api" | "sample"
  importedAt    DateTime @default(now())

  @@index([venueId, date])
}

model PipelineDeal {
  id             String    @id @default(cuid())
  brandName      String
  category       String
  tier           String
  status         String    @default("prospect")
  value          Float?
  contactName    String?
  contactEmail   String?
  notes          String?
  venues         String?   // JSON array of venue IDs
  dealPoints     String?   // JSON array of { type, venues, status }
  nextAction     String?
  nextActionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PitchLink {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  title      String
  brandName  String?
  category   String?
  venueIds   String?   // JSON array
  expiresAt  DateTime
  viewCount  Int       @default(0)
  lastViewed DateTime?
  createdAt  DateTime  @default(now())
}

model APICredential {
  id        String    @id @default(cuid())
  service   String    // "toast" | "sevenrooms"
  config    String    // encrypted JSON
  lastSync  DateTime?
  status    String    @default("configured")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RecapLog {
  id     String   @id @default(cuid())
  type   String
  sentTo String
  sentAt DateTime @default(now())
  data   String?
}

model Artist {
  id               String   @id @default(cuid())
  stageName        String   @unique
  realName          String
  born             String   @default("")
  nationality      String
  genres           String   @default("[]") // JSON: string[]
  yearsActive      String
  signature        String   @default("")
  bio              String
  hits             String   // JSON: ArtistHit[]
  albums           String   @default("[]") // JSON: ArtistAlbum[]
  collaborations   String   @default("[]") // JSON: string[]
  milestones       String   // JSON: string[]
  reach            String   // JSON: ArtistReachMetric[]
  outreachExamples String   @default("[]") // JSON: ArtistOutreach[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  recaps           FtbRecap[]
}

model FtbRecap {
  id          String   @id @default(cuid())
  eventId     String   @unique // URL slug, e.g. "marshmello-apr2-2026"
  status      String   @default("draft") // "draft" | "published"
  headliner   String
  eventDate   String
  eventDay    String
  placerData  String   // JSON: PlacerEventDataset shape
  coverage    String   // JSON: DataCoverage
  photos      String   // JSON: { hero, polaroid, portrait, gallery[] }
  sponsors    String   // JSON: [{ name, role }]
  execSummary String?  // JSON override; null = use FTB default
  tickets     String?  // JSON: TicketsAggregate (BLOCKPARTY.VEGAS CSV → counts only, no PII)
  artistId    String?
  artist      Artist?  @relation(fields: [artistId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  recipients  FtbRecapRecipient[]
}

model FtbRecapRecipient {
  id          String   @id @default(cuid())
  recapId     String
  recap       FtbRecap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  group       String?  // "sponsors" | "media" | "city" | "lvcva" | "diageo"
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  resendId    String?
  createdAt   DateTime @default(now())

  @@index([recapId])
  @@index([resendId])
}

model FtbRecipientGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  emails    String   // JSON: [{ email, name? }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
